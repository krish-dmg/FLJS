<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="is_full_switch"
        android:summary="@string/pref_description_easy_full"
        android:title="@string/pref_title_easy_full" />

    <ListPreference
        android:defaultValue="4"
        android:entries="@array/pref_choices_list_entries"
        android:entryValues="@array/pref_choices_list_values"
        android:key="choices_list"
        android:negativeButtonText="@null"
        android:positiveButtonText="@null"
        android:title="@string/pref_choices_title" />

    <ListPreference
        android:defaultValue="50"
        android:entries="@array/pref_count_list_entries"
        android:entryValues="@array/pref_count_list_values"
        android:key="count_list"
        android:negativeButtonText="@null"
        android:positiveButtonText="@null"
        android:title="@string/pref_count_title" />


    <ListPreference
        android:defaultValue="system"
        android:entries="@array/dark_mode_entries"
        android:entryValues="@array/dark_mode_values"
        android:key="theme_mode"
        android:title="Dark Mode Override" />

    <PreferenceCategory
        android:title="Study Reminders">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="study_reminders_enabled"
            android:summary="Receive study alerts to stay consistent with JLPT preparation"
            android:title="Enable Study Reminders" />

        <ListPreference
            android:defaultValue="multiple"
            android:entries="@array/pref_reminder_frequency_entries"
            android:entryValues="@array/pref_reminder_frequency_values"
            android:key="reminder_frequency"
            android:negativeButtonText="@null"
            android:positiveButtonText="@null"
            android:title="Reminder Frequency" />

        <EditTextPreference
            android:defaultValue="20:00"
            android:dependency="study_reminders_enabled"
            android:key="notification_time"
            android:summary="Set time in 24h format (e.g. 20:00)"
            android:title="Custom Reminder Time (HH:MM)" />

        <Preference
            android:key="send_test_notification"
            android:summary="Tap to verify notification delivery immediately"
            android:title="Send Test Notification Now" />

    </PreferenceCategory>

</PreferenceScreen>
